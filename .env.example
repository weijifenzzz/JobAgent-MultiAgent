# 模型配置也可以继续通过网页填写。
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=

# 搜索和网页抓取分别需要对应服务的密钥。
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# 默认关闭调用追踪。
LANGCHAIN_TRACING_V2=false

# 本地 MySQL；不要将真实密码提交到 Git。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=jobagent

# 向量模型
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# 向量数据库
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jobagent_knowledge_v1
